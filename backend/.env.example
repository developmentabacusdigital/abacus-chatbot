# ===== Required =====

# OpenRouter API key — the bot cannot generate answers without this
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Postgres connection string. On Neon, use the *pooled* connection string (hostname
# contains "-pooler") — a serverless function can spin up many concurrent instances,
# each holding its own small connection pool, and going through Neon's PgBouncer
# endpoint keeps that from exhausting the underlying Postgres connection limit.
# Local dev: point this at any Postgres you have running, or leave unset and the
# test suite will spin up a throwaway embedded instance automatically.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Free-tier embedding API for RAG (replaces local sentence-transformers, which is too
# large/slow for a serverless cold start). Get a free key at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Protects the internal dashboard, admin API, and /api/cron/* endpoints. Generate one
# with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, the entire /api/admin surface refuses requests.
ADMIN_API_KEY=

# Lets Vercel Cron call /api/cron/* without the admin key. Vercel sends this
# automatically as "Authorization: Bearer <value>" once set as a project env var —
# generate the same way as ADMIN_API_KEY. Optional for local dev.
CRON_SECRET=

# ===== Booking =====
CALENDLY_URL=https://calendly.com/abacusdigital/discovery

# ===== CORS =====
# Must include the Framer domain the widget is embedded on
CORS_ORIGINS=https://www.abacusdigital.net,https://abacusdigital.net,http://localhost:8000,http://127.0.0.1:5500,http://localhost:3829,http://127.0.0.1:3829

# ===== Rate limiting =====
MAX_MESSAGES_PER_SESSION=100
MAX_SESSIONS_PER_IP_PER_HOUR=20

# ===== Site crawling / re-indexing (PRD 7.1) =====
SITE_BASE_URL=https://www.abacusdigital.net
CRAWL_ENABLED=true
CRAWL_MAX_PAGES=120
REINDEX_INTERVAL_HOURS=24

# ===== Transactional email (Phase 2) =====
# resend | brevo | none
EMAIL_PROVIDER=none
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=Abacus Digital <hello@abacusdigital.net>
EMAIL_REPLY_TO=hello@abacusdigital.net
# Keep true until you trust the drafts: emails queue for approval in the dashboard
EMAIL_REQUIRE_APPROVAL=true

# Internal alert sent the moment a visitor's name + email are both known, with a
# snapshot of the conversation so far (industry, requirement, budget, timeline, etc).
# Goes straight out (no approval step, unlike visitor-facing email) since it's for your
# team, not the visitor. Requires EMAIL_PROVIDER above to actually be configured.
# Leave blank to disable.
LEAD_NOTIFICATION_EMAIL=

# ===== CRM mirror (optional — the app's own DB is the system of record) =====
# airtable | hubspot | none
CRM_PROVIDER=none
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads
HUBSPOT_ACCESS_TOKEN=

# ===== Phase 3: client portal =====
CLIENT_AUTH_ENABLED=true
MAGIC_LINK_TTL_MINUTES=20
CLIENT_SESSION_TTL_HOURS=72
# Page hosting the client-mode widget; magic links point here
CLIENT_PORTAL_URL=https://www.abacusdigital.net/client
ACCOUNT_MANAGER_EMAIL=accounts@abacusdigital.net
